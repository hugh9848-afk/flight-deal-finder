# ── Travelpayouts (넓게 훑기 · 무료) ────────────────────────────
# www.travelpayouts.com 가입 후 대시보드에서 발급
TRAVELPAYOUTS_TOKEN=
# 링크에 붙는 제휴 번호. 없어도 동작합니다.
TRAVELPAYOUTS_MARKER=

# ── SerpApi (상세 조회) ───────────────────────────────────────
SERPAPI_API_KEY=
# 친구가 공동 사용에 제공한 별도 계정의 키. 없으면 비워둡니다.
SERPAPI_API_KEY_FRIEND=
# 두 번째 친구의 별도 계정. 위와 다른 이름을 사용합니다.
SERPAPI_API_KEY_FRIEND_2=
# 아래 월 상한은 계정 하나마다 적용됩니다 (두 계정 400회 / 세 계정 600회).
SERPAPI_MONTHLY_BUDGET=200
# 비우면 키 하나 19회 / 둘 35회 / 셋 51회. 자동 실행에서도 동일합니다.
SERPAPI_RUN_BUDGET=

# ── 알림 (선택) ────────────────────────────────────────────────
NOTIFY_WEBHOOK_URL=

# Amadeus Self-Service API 키 (developers.amadeus.com 에서 무료 발급)
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
# test = 무료 테스트 서버(데이터 일부만), production = 실제 데이터
AMADEUS_ENV=test
